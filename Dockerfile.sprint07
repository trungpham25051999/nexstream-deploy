FROM debian:bookworm AS build
RUN apt-get update && apt-get install -y --no-install-recommends build-essential cmake libprotobuf-dev protobuf-compiler libssl-dev libsqlite3-dev librdkafka-dev libpq-dev libcurl4-openssl-dev nlohmann-json3-dev
WORKDIR /src
COPY nexstream-contracts /src/nexstream-contracts
RUN cmake -S nexstream-contracts -B /tmp/contracts -DBUILD_TESTING=OFF -DCMAKE_INSTALL_PREFIX=/opt/contracts && cmake --build /tmp/contracts -j2 && cmake --install /tmp/contracts
ARG SERVICE
COPY ${SERVICE} /src/${SERVICE}
RUN cmake -S ${SERVICE} -B /tmp/app -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DCMAKE_PREFIX_PATH=/opt/contracts -DLIBPQ_INCLUDE_DIR=/usr/include/postgresql && cmake --build /tmp/app -j2 && mkdir /out && cp /tmp/app/nexstream-* /out/
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends libprotobuf32 libssl3 libsqlite3-0 librdkafka1 libpq5 libcurl4 curl ca-certificates && rm -r /var/lib/apt/lists/*
COPY --from=build /out/ /usr/local/bin/
RUN mkdir -p /state && chown 65534:65534 /state
USER 65534:65534
